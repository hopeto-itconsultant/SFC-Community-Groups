# Copy to .env.local and fill in from the Supabase dev project:
# Project Settings > API Keys (and Project Settings > Data API for the URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only: bypasses all access rules. Never use it in browser code or commit it.
SUPABASE_SECRET_KEY=sb_secret_...
